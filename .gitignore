# Python
__pycache__/
*.pyc

# Кэши глифов/шрифтов (генерируются из доноров)
*.pkl
# Каталоги новых банков нужны боту как есть, это не кэш сборки
!banks/rshb/*.pkl
!banks/ozon/*.pkl
!banks/disk/*.pkl
!fullbot/*.pkl
!fullbot/**/*.pkl

# Результаты генераций (любой out/ в проекте)
out/

# Тестовые генерации в корне: UUID-чеки, out_*, черновики и превью
/*.pdf
/*.png

# …но настоящие доноры и оригиналы в корне не теряем:
!/Квитанция.pdf
!/Квитанция ру.pdf
!/yandex_fresh.pdf
!/yandex_10000.pdf

# Служебные черновики исследования
/_*.pdf
/_*.txt

# Логи и секреты окружения
logs/
.env
bot_access.json

# Системное
.DS_Store

# Temurin JRE, скачивается на Render при старте
/jre/
