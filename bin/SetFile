#!/bin/sh
# Заглушка macOS-утилиты SetFile для Linux-серверов.
# Движок чеков Рокета после сохранения PDF зовёт `SetFile -d ... -m ...`
# (дата создания файла на macOS); на Linux её нет, а движок заморожен.
# Временная метка файла уже выставлена через os.utime до этого вызова,
# поэтому на сервере достаточно ничего не делать и вернуть успех.
exit 0
